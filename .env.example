# =============================================================================
# Trend Business AI — environment
# Platform launch: docs/PRODUCTION_LAUNCH.md + docs/LAUNCH_CHECKLIST.md
# Staging: docs/STAGING_SETUP.md + .env.staging.example
# Website Builder detail: docs/WEBSITE_BUILDER_DEPLOYMENT_READY.md
# Production P0: SITE_URL (https), Supabase URL+anon, SERVICE_ROLE, DEEPSEEK_API_KEY
# Verify: npm run verify:launch [-- --production]
# Staging verify: npm run verify:staging [-- --strict]
# Go-live: npm run verify:golive [-- --production] [-- --paid]
# Optional HTTP: PRODUCTION_BASE_URL=https://your-domain
# Optional error monitoring: SENTRY_DSN=
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local dev: http://localhost:3003 (default) — set PORT/DEV_PORT and match NEXT_PUBLIC_SITE_URL
# Production: https://your-domain (no trailing slash)
# PORT=3003
# DEV_PORT=3003
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Database migrations. Direct/session Postgres URI — required for npm run db:apply
# Supabase Dashboard → Project Settings → Database → Connection string
# SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# AI — DeepSeek is the default text/code provider (Website Builder + all Core products).
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional text providers (multi-AI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
LLAMA_API_KEY=

# AI Real Images Engine (visual generation only — not used for text/code)
# Preferred: openai | replicate | stability (falls through configured providers)
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY also powers DALL·E when set
# REPLICATE_API_TOKEN=
# REPLICATE_FLUX_MODEL=black-forest-labs/flux-schnell
# STABILITY_API_KEY=
# STABILITY_IMAGE_MODEL=sd3.5-large

# Billing (PayPal Checkout + Visa/Mastercard hosted card flow)
# Sandbox: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
# P0 for production: Dashboard → Settings → API → service_role (server-only, never NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=
# Production fail-closed for billing. Set true only for local/demo without billing tables.
# BILLING_OPTIONAL=false
# Dev-only: allow unsigned PayPal webhooks (never in production)
# ALLOW_INSECURE_PAYPAL_WEBHOOKS=false

# Optional logging / health
LOG_LEVEL=info
# HEALTH_DETAILED=false

# SEO / Analytics (optional — enables GSC, GA4, Bing, GTM when set)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# P1 for public launch: global AI/auth rate limiting
# When unset in production, API routes use per-instance memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Website Builder SSE stream duration (seconds). Vercel Pro defaults to 300; self-hosted up to 1800.
# WEBSITE_STREAM_MAX_DURATION_SEC=900
# Client DB recovery poll window after SSE disconnect (ms). Default: server max + 10 min (min 25 min).
# WEBSITE_STREAM_RECOVERY_POLL_MS=1500000

# Preview builder (npm install + build on generated projects). RCE risk if enabled.
# H08 / D-004: keep false. Unset or false = off. Production hard-disables even if true.
# Only consider true in local/dev after an Accepted security decision (F01).
WEBSITE_PREVIEW_BUILDER_ENABLED=false

# -----------------------------------------------------------------------------
# Video Studio — AI video production (providers, TTS, FFmpeg, cron worker)
# At least one video provider + TTS + FFmpeg required for full production output.
# Verify: npm run verify:video-studio
# Health: GET /api/video-studio/health (authenticated)
# Cron worker: POST /api/video-studio/cron with Bearer VIDEO_STUDIO_CRON_SECRET
# Schedule every 1–2 minutes in production. Missing secret or ops config fails closed.
# -----------------------------------------------------------------------------
# Video generation (configure one or more — see docs/VIDEO_STUDIO_PROVIDER_SETUP.md)
# Gemini / Veo (disabled by default — set GEMINI_ENABLED=true to route to Veo / Omni Flash):
GEMINI_ENABLED=false
# Veo (Gemini API) — Phase 6B primary when GEMINI_ENABLED=true and key set:
# GEMINI_API_KEY=
# VEO_MODEL=veo-3.1-generate-preview
# Primary for full renders:
# KLING_API_KEY=
# KLING_API_BASE_URL=https://api.klingai.com/v1
# Avatar lane only:
# HEYGEN_API_KEY=
# HEYGEN_AVATAR_ID=
# HEYGEN_VOICE_ID=
# Optional fallback video providers (used when KLING_API_KEY is unset)
# RUNWAY_API_KEY=
# RUNWAY_API_BASE_URL=https://api.dev.runwayml.com/v1
# RUNWAY_MODEL=gen3a_turbo
# VIDEO_PROVIDER_API_KEY=
# VIDEO_PROVIDER_BASE_URL=
# Video Studio AI stack: deepseek (default) | multi (enable Gemini/OpenAI TTS/STT/Imagen)
VIDEO_STUDIO_AI_STACK=deepseek
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY=
# Stock media providers (Video Studio stock library — optional; curated catalog used as fallback)
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# UNSPLASH_ACCESS_KEY=
# Assembly (required for multi-scene merge, burn-in, social re-encode)
# Windows dev: see docs/VIDEO_STUDIO_LOCAL_SETUP.md — set explicit path if ffmpeg is not on PATH
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
# FFMPEG_BINARY=   # alias for FFMPEG_PATH
# FFPROBE_PATH=    # optional; derived from FFMPEG_PATH when omitted
# Production hardening (required in production — fail closed)
VIDEO_PROVIDER_STRICT=1
# VIDEO_STUDIO_CRON_SECRET=
# Apply DB: npm run db:apply -- --only 044,045,100,101,102,103,104,105
#
# Video Studio production launch checklist:
# 1. KLING_API_KEY and/or RUNWAY_API_KEY (or GEMINI_ENABLED=true + GEMINI_API_KEY for Veo)
# 2. ELEVENLABS_API_KEY or OPENAI_API_KEY for narrated videos
# 3. FFMPEG_PATH set on the host
# 4. VIDEO_STUDIO_CRON_SECRET + schedule POST /api/video-studio/cron every 1–2 min
# 5. SUPABASE_SERVICE_ROLE_KEY for cron worker and private media bucket
# 6. npm run verify:video-studio (or verify:video-studio:launch for strict)

# Public hosted websites at /w/[slug]. Default ON when unset. Set false to disable public hosting.
# In-platform live preview uses /api/website-builder/[id]/live-preview (always available when authenticated).
# WEBSITE_PUBLISH_ENABLED=true
# WEBSITE_PUBLISH_ENABLED=false

# App Builder — live preview at /api/webapp-builder/[id]/live-preview (authenticated).
# Deploy preview = live-preview sandbox. Production button = public HTML host at /w/app/[slug].
# Full Next.js Node host = ZIP download + self-host, then register HTTPS URL in App Stores tab.
# Platform never npm-builds customer apps (D-004).
# WEBAPP_DEPLOY_ENABLED=true
# WEBAPP_PUBLISH_ENABLED=true
# Verify scaffold typecheck: npm run verify:app-builder:scaffold
# Verify scaffold next build: npm run verify:app-builder:scaffold:build
# Launch gate: npm run verify:app-builder:launch
# Deep E2E (requires DEEPSEEK_API_KEY): npm run e2e:app-builder
# Apply DB: npm run db:apply -- --only 046,076,097
# Launch checklist: docs/APP_BUILDER_PRODUCTION_LAUNCH.md

# TBGE — Trend Business AI Generation Engine (Sprint 1 foundation; all default OFF)
# TBGE_ENABLED=1
# TBGE_SHADOW_MODE=1
# TBGE_ASSEMBLY=1
# TBGE_COMPOSER=1
# TBGE_PLANNING=1
# TBGE_CONTENT_MODEL=1
# TBGE_LEGACY_FILE_LLM=1
# TBGE_LEGACY_REPAIR=0
# TBGE_CUSTOM_LOGIC=0
# TBGE_SPEC_CHECKPOINT=1
# TBGE_LEGACY_FULL=0

# -----------------------------------------------------------------------------
# Universal AI Planner flags (default OFF)
# Enable Website Builder integration only after validation:
#   UNIVERSAL_PLANNER_ENABLED=1
#   UNIVERSAL_PLANNER_WEBSITE_ENABLED=1
#   UNIVERSAL_PLANNER_APP_ENABLED=1
# -----------------------------------------------------------------------------
# UNIVERSAL_PLANNER_ENABLED=1
# UNIVERSAL_PLANNER_WEBSITE_ENABLED=1
# UNIVERSAL_PLANNER_APP_ENABLED=1

# -----------------------------------------------------------------------------
# Website Builder platform flags (WB_*) — all default OFF
# Docs: docs/platform-roadmap/FLAGS.md
# Internal QA profile (enable all for local testing):
#   WB_SITE_PLAN_V1=1
#   WB_STRUCTURE_FIRST=1
#   WB_VISUAL_SKIN_V1=1
#   WB_PUBLISH_GATE=1
#   WB_PRO_WORKSPACE=1
#   NEXT_PUBLIC_WB_PRO_WORKSPACE=1
# -----------------------------------------------------------------------------
# WB_SITE_PLAN_V1=1
# WB_STRUCTURE_FIRST=1
# WB_VISUAL_SKIN_V1=1
# WB_PUBLISH_GATE=1
# WB_PRO_WORKSPACE=1
# NEXT_PUBLIC_WB_PRO_WORKSPACE=1
# WB_LOCALE_LLM=1
