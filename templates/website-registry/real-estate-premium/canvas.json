{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.75rem",
    "margin": "1.5rem",
    "maxWidth": "90rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": ["0.5", "1", "1.5", "2", "3", "4", "5", "6", "8", "10", "12"]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#1C1C1E",
      "secondary": "#3A3A3C",
      "accent": "#A67C52",
      "background": "#F5F0EB",
      "foreground": "#1C1C1E",
      "muted": "rgba(28,28,30,0.58)",
      "surface": "#FDFBF8",
      "stone": "#E5DFD8",
      "brass": "#A67C52",
      "linen": "#FAF7F3"
    },
    "typography": {
      "display": "Cormorant, Georgia, ui-serif, serif",
      "body": "Work Sans, ui-sans-serif, system-ui, sans-serif",
      "scale": {
        "sm": "0.8125rem",
        "base": "1.0625rem",
        "lg": "1.375rem",
        "xl": "3.5rem",
