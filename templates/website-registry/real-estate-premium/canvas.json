    "borders": {
      "default": "rgba(28,28,30,0.1)",
      "brass": "rgba(166,124,82,0.35)",
      "subtle": "rgba(28,28,30,0.05)"
    },
    "animation": "prestige-reveal"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "Real Estate",
    "layoutKind": "sidebar-right",
    "templateIntelligenceId": "ti-real-estate-listings"
