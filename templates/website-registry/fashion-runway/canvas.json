{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "2.5rem",
    "margin": "0",
    "maxWidth": "100%"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.5",
      "1",
      "2",
      "4",
      "6",
      "10",
      "14",
      "20"
    ]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#050505",
      "secondary": "#525252",
      "accent": "#DC2626",
      "background": "#0A0A0A",
      "foreground": "#FAFAFA",
      "muted": "rgba(250,250,250,0.6)",
      "surface": "#171717"
    },
    "typography": {
      "display": "Bodoni Moda, ui-serif, Georgia, serif",
      "body": "Neue Haas Grotesk, ui-sans-serif, system-ui, sans-serif",
