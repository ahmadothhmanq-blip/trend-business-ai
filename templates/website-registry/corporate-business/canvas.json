{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "1.25rem",
    "maxWidth": "82rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": ["0.5", "1", "1.5", "2", "3", "4", "5", "6", "8", "10", "12"]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#0F2B46",
      "secondary": "#1E4976",
      "accent": "#C5A572",
      "background": "#FFFFFF",
      "foreground": "#0F172A",
      "muted": "rgba(15,23,42,0.58)",
      "surface": "#F8FAFC",
      "signal": "#C5A572",
      "grid": "rgba(15,43,70,0.06)",
      "ink": "#071018"
    },
    "typography": {
      "display": "IBM Plex Sans, ui-sans-serif, system-ui, sans-serif",
      "body": "IBM Plex Sans, ui-sans-serif, system-ui, sans-serif",
      "mono": "IBM Plex Mono, ui-monospace, monospace",
      "scale": {
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.375rem",
        "xl": "2.75rem",
