      "glow": "0 0 80px rgba(197,165,114,0.18)",
      "card": "0 0 0 1px rgba(15,43,70,0.04), 0 4px 24px rgba(15,43,70,0.06)"
    },
    "borders": {
      "default": "rgba(15,43,70,0.08)",
      "accent": "rgba(197,165,114,0.28)",
      "subtle": "rgba(15,43,70,0.04)"
    },
    "animation": "atlas-reveal"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "Corporate",
    "layoutKind": "single-column",
    "templateIntelligenceId": "ti-corporate-trust"
  }
