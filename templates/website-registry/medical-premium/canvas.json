{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "1.25rem",
    "maxWidth": "76rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": ["0.5", "1", "1.5", "2", "3", "4", "5", "6", "8", "9"]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#1A4D4A",
      "secondary": "#2A6560",
      "accent": "#C4A882",
      "background": "#FAFCFA",
      "foreground": "#162826",
      "muted": "rgba(22,40,38,0.58)",
      "surface": "#E8EDE6",
      "healing": "#6B9B8A",
      "pearl": "#FAFCFA",
      "sage": "#D8E2D4"
    },
    "typography": {
      "display": "Libre Baskerville, Georgia, ui-serif, serif",
      "body": "Source Sans 3, ui-sans-serif, system-ui, sans-serif",
      "scale": {
        "sm": "0.875rem",
        "base": "1.0625rem",
        "lg": "1.25rem",
        "xl": "2.75rem",
        "display": "clamp(2.75rem, 5.2vw, 4rem)"
      }
    },
    "radius": {
      "sm": "4px",
      "md": "10px",
      "lg": "18px"
    },
    "shadows": {
      "surface": "0 8px 32px rgba(26,77,74,0.09)",
      "glow": "0 0 48px rgba(107,155,138,0.14)",
      "card": "0 1px 2px rgba(22,40,38,0.04), 0 12px 32px rgba(26,77,74,0.07)"
    },
    "borders": {
      "default": "rgba(22,40,38,0.09)",
      "healing": "rgba(107,155,138,0.28)",
      "subtle": "rgba(22,40,38,0.05)"
    },
    "animation": "serenity-fade"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "Healthcare",
    "layoutKind": "full-bleed",
    "templateIntelligenceId": "ti-medical-care"
  }
}
