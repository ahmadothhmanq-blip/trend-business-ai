{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "0",
    "maxWidth": "100%"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.5",
      "1",
      "1.5",
      "2.5",
      "4",
      "6",
      "8",
      "12"
    ]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#1C1917",
      "secondary": "#78716C",
      "accent": "#D6A45B",
      "background": "#0C0A09",
      "foreground": "#FAF7F2",
      "muted": "rgba(250,247,242,0.62)",
      "surface": "#1C1917"
    },
    "typography": {
      "display": "Cormorant Garamond, ui-serif, Georgia, serif",
      "body": "Outfit, ui-sans-serif, system-ui, sans-serif",
      "scale": {
        "sm": "0.9375rem",
        "base": "1.0625rem",
        "lg": "1.625rem",
        "xl": "3.5rem"
      }
    },
    "radius": {
      "sm": "2px",
      "md": "4px",
      "lg": "8px"
    },
    "shadows": {
      "surface": "0 24px 80px rgba(0,0,0,0.35)"
    },
    "borders": {
      "default": "rgba(0,0,0,0.08)"
    },
    "animation": "cinematic-reveal"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "Restaurant",
    "layoutKind": "full-bleed",
    "templateIntelligenceId": "ti-restaurant-dining"
  }
}
