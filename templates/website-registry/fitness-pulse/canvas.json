{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1rem",
    "margin": "1rem",
    "maxWidth": "78rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.25",
      "0.5",
      "0.75",
      "1",
      "1.5",
      "2.5",
      "4",
      "6"
    ]
  },
  "visualIdentity": {
