    "maxWidth": "100%"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.5",
      "1",
      "1.5",
      "2",
      "3",
      "4",
      "6",
      "10"
    ]
  },
  "visualIdentity": {
