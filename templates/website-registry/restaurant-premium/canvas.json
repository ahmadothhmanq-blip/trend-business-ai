{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "1.25rem",
    "maxWidth": "90rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.5",
      "1",
      "1.5",
      "2",
      "3",
      "4",
      "5",
      "6",
      "8",
      "10",
      "12"
    ]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#1A3D32",
      "secondary": "#264A3E",
      "accent": "#B87333",
      "background": "#0A1210",
      "foreground": "#F4EDE4",
      "muted": "rgba(244,237,228,0.58)",
      "surface": "#121F1A",
      "copper": "#D4A574",
      "ember": "#8B5A2B",
      "linen": "#FFFCF7"
    },
    "typography": {
      "display": "Cormorant Garamond, Georgia, ui-serif, serif",
      "body": "DM Sans, ui-sans-serif, system-ui, sans-serif",
