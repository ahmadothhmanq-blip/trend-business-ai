{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "1.25rem",
    "maxWidth": "82rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": ["0.5", "1", "1.5", "2", "3", "4", "5", "6", "8", "10", "12"]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#1D4ED8",
      "secondary": "#1E293B",
      "accent": "#3B82F6",
      "background": "#F8FAFC",
      "foreground": "#0F172A",
      "muted": "rgba(15,23,42,0.58)",
      "surface": "#FFFFFF",
      "signal": "#059669",
      "grid": "rgba(15,23,42,0.06)",
      "ink": "#020617"
    },
    "typography": {
      "display": "Plus Jakarta Sans, ui-sans-serif, system-ui, sans-serif",
      "body": "IBM Plex Sans, ui-sans-serif, system-ui, sans-serif",
      "mono": "IBM Plex Mono, ui-monospace, monospace",
      "scale": {
        "sm": "0.8125rem",
        "base": "1rem",
        "lg": "1.25rem",
        "xl": "3rem",
        "display": "clamp(2.5rem, 5vw, 3.75rem)"
      }
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "16px",
      "xl": "24px"
    },
    "shadows": {
      "surface": "0 1px 3px rgba(15,23,42,0.06), 0 12px 40px rgba(15,23,42,0.08)",
      "glow": "0 0 80px rgba(59,130,246,0.18)",
      "card": "0 0 0 1px rgba(15,23,42,0.04), 0 4px 24px rgba(15,23,42,0.06)"
    },
    "borders": {
      "default": "rgba(15,23,42,0.08)",
      "accent": "rgba(59,130,246,0.24)",
      "subtle": "rgba(15,23,42,0.04)"
    },
    "animation": "nexus-grid-reveal"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "SaaS",
    "layoutKind": "single-column",
    "templateIntelligenceId": "ti-saas-growth"
  }
}
