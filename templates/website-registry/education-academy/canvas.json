{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "1.5rem",
    "maxWidth": "80rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.25",
      "0.5",
      "1",
      "1.5",
      "2",
      "3",
      "5",
      "8"
    ]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#1D4ED8",
      "secondary": "#0F766E",
      "accent": "#F59E0B",
