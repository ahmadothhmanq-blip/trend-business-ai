    "colors": {
      "primary": "#12100E",
      "secondary": "#2A2724",
      "accent": "#C9A962",
      "background": "#FAF8F5",
      "foreground": "#12100E",
      "muted": "rgba(18,16,14,0.58)",
      "surface": "#FFFFFF",
      "linen": "#F3EFE8",
      "champagne": "#C9A962",
      "ink": "#12100E",
      "grid": "rgba(18,16,14,0.05)"
    },
    "typography": {
      "display": "Playfair Display, Georgia, ui-serif, serif",
      "body": "Manrope, ui-sans-serif, system-ui, sans-serif",
      "mono": "Manrope, ui-sans-serif, system-ui, sans-serif",
