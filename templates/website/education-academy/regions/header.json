{
  "id": "header",
  "role": "header",
  "label": "Header Region",
  "layout": {
    "width": "contained",
    "alignment": "center",
    "maxWidth": "80rem",
    "padding": "1.75rem"
  },
  "placement": {
    "allowedComponentTypes": [
      "navigation",
      "logo",
      "cta",
      "custom"
    ],
    "ordering": "horizontal",
    "allowNesting": false,
    "maxComponents": 10,
    "minComponents": 0,
    "allowCustomComponents": true
  },
  "responsive": {
    "collapseBelow": "md",
    "stackOrder": "normal"
  }
}
