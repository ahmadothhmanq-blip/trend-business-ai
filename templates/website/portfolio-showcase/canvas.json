{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "2.5rem",
    "margin": "0",
    "maxWidth": "100%"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.5",
      "1",
      "2",
      "3",
      "5",
      "8",
      "10",
      "14"
    ]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#18181B",
      "secondary": "#71717A",
      "accent": "#E11D48",
      "background": "#FAFAFA",
      "foreground": "#18181B",
      "muted": "rgba(24,24,27,0.55)",
      "surface": "#FFFFFF"
    },
    "typography": {
      "display": "Fraunces, ui-serif, Georgia, serif",
      "body": "Inter, ui-sans-serif, system-ui, sans-serif",
      "scale": {
        "sm": "0.875rem",
        "base": "1.0625rem",
        "lg": "1.5rem",
        "xl": "3.25rem"
      }
    },
    "radius": {
      "sm": "0",
      "md": "0",
      "lg": "0"
