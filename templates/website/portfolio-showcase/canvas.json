    "borders": {
      "default": "rgba(0,0,0,0.08)"
    },
    "animation": "magazine-flow"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "Portfolio",
    "layoutKind": "full-bleed",
    "templateIntelligenceId": "ti-blog-editorial"
