    "shadows": {
      "surface": "0 8px 32px rgba(37,99,235,0.12)"
    },
    "borders": {
      "default": "rgba(0,0,0,0.08)"
    },
    "animation": "card-stagger"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "SaaS",
    "layoutKind": "single-column",
    "templateIntelligenceId": "ti-saas-growth"
