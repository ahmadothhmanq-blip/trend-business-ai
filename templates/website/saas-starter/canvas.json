{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1rem",
    "margin": "1.25rem",
    "maxWidth": "80rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.25",
      "0.5",
      "1",
      "1.25",
      "2",
      "3",
      "4",
      "5"
    ]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#4F46E5",
      "secondary": "#312E81",
      "accent": "#22D3EE",
      "background": "#FFFFFF",
      "foreground": "#0F172A",
      "muted": "rgba(15,23,42,0.55)",
      "surface": "#EEF2FF"
    },
    "typography": {
      "display": "Space Grotesk, ui-sans-serif, system-ui, sans-serif",
      "body": "DM Sans, ui-sans-serif, system-ui, sans-serif",
      "scale": {
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.375rem",
        "xl": "2.5rem"
      }
    },
    "radius": {
      "sm": "8px",
      "md": "14px",
      "lg": "24px"
