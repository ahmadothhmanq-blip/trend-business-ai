{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.75rem",
    "margin": "1.5rem",
    "maxWidth": "76rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.5",
      "1",
      "1.5",
      "2.5",
      "4",
      "6",
      "8",
      "12"
    ]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#0D9488",
      "secondary": "#14B8A6",
      "accent": "#F59E0B",
      "background": "#FFFBEB",
      "foreground": "#134E4A",
      "muted": "rgba(19,78,74,0.58)",
      "surface": "#FFFFFF"
    },
    "typography": {
      "display": "Merriweather, ui-serif, Georgia, serif",
      "body": "Source Sans 3, ui-sans-serif, system-ui, sans-serif",
