{
  "id": "utility",
  "role": "utility",
  "label": "Utility Region",
  "layout": {
    "width": "contained",
    "alignment": "center",
    "maxWidth": "76rem",
    "padding": "1.75rem"
  },
  "placement": {
    "allowedComponentTypes": [
      "gallery",
      "testimonials",
      "contact",
      "pricing",
      "custom"
    ],
    "ordering": "vertical",
    "allowNesting": false,
    "maxComponents": 10,
    "minComponents": 0,
    "allowCustomComponents": true
  },
  "responsive": {
    "collapseBelow": "md",
    "stackOrder": "normal"
  }
}
