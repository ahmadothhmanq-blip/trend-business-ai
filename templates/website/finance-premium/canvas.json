  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "1.25rem",
    "maxWidth": "82rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": ["0.5", "1", "1.5", "2", "3", "4", "5", "6", "8", "10", "12"]
