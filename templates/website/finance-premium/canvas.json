      "signal": "#C9A227",
      "grid": "rgba(13,27,42,0.06)",
      "ink": "#0A1520"
    },
    "typography": {
      "display": "Playfair Display, Georgia, serif",
      "body": "Lato, ui-sans-serif, system-ui, sans-serif",
      "mono": "IBM Plex Mono, ui-monospace, monospace",
