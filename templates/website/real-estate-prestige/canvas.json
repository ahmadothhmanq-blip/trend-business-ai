{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "1.25rem",
    "maxWidth": "88rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": ["0.5", "1", "1.5", "2", "3", "4", "5", "6", "8", "10", "12"]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#0E0D0B",
      "secondary": "#16130F",
      "accent": "#C9AE72",
      "background": "#090807",
      "foreground": "#F4EDE3",
      "muted": "rgba(228, 212, 188, 0.62)",
      "surface": "#12100D",
      "surface-elevated": "#1A1612",
      "signal": "#C9AE72",
      "grid": "rgba(201, 174, 114, 0.075)",
      "ink": "#090807",
      "stone": "rgba(244, 237, 227, 0.10)",
      "brass": "#C9AE72",
      "brass-light": "#DCC894",
      "brass-deep": "#9E8248",
      "linen": "#15120E"
    },
    "typography": {
      "display": "Fraunces, ui-serif, Georgia, serif",
      "body": "Outfit, ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, monospace",
      "scale": {
        "sm": "0.8125rem",
        "base": "1.0625rem",
        "lg": "1.375rem",
        "xl": "3.25rem",
        "display": "clamp(2.75rem, 6vw, 4.5rem)"
      }
    },
    "radius": {
      "sm": "2px",
      "md": "4px",
      "lg": "8px",
      "xl": "12px"
