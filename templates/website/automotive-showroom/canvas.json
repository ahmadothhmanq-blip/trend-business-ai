{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "0",
    "maxWidth": "100%"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.5",
      "1",
      "1.5",
      "2.5",
      "4",
      "6",
      "8",
      "12"
    ]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#101010",
      "foreground": "#FAFAFA",
      "muted": "rgba(250,250,250,0.6)",
      "surface": "#171717"
    },
    "typography": {
      "display": "Eurostile, ui-sans-serif, system-ui, sans-serif",
      "body": "Inter, ui-sans-serif, system-ui, sans-serif",
      "scale": {
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.5rem",
        "xl": "3.25rem"
      }
    },
    "radius": {
      "sm": "2px",
      "md": "4px",
      "lg": "6px"
    },
    "shadows": {
      "surface": "0 24px 80px rgba(0,0,0,0.35)"
    },
    "borders": {
      "default": "rgba(0,0,0,0.08)"
    },
    "animation": "showroom-cinematic"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "Automotive",
    "layoutKind": "full-bleed",
    "templateIntelligenceId": "ti-automotive-showroom"
  }
}
