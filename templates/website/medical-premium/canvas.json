{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "1.25rem",
    "maxWidth": "76rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": ["0.5", "1", "1.5", "2", "3", "4", "5", "6", "8", "10", "12"]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#1B4D48",
      "secondary": "#2A635D",
      "accent": "#C4A882",
      "background": "#F7FAF8",
      "foreground": "#142E2B",
      "muted": "rgba(20,46,43,0.56)",
      "surface": "#FFFFFF",
      "signal": "#C4A882",
      "grid": "rgba(27,77,72,0.05)",
      "ink": "#1B4D48",
      "healing": "#9ca286",
      "pearl": "#F7FAF8",
      "sage": "#c4d4d1"
    },
    "typography": {
      "display": "Libre Baskerville, ui-serif, Georgia, serif",
      "body": "Source Sans 3, ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, monospace",
      "scale": {
        "sm": "0.875rem",
        "base": "1.0625rem",
        "lg": "1.25rem",
        "xl": "2.75rem",
        "display": "clamp(2.75rem, 5.2vw, 4rem)"
      }
    },
    "radius": {
      "sm": "4px",
      "md": "10px",
      "lg": "18px",
      "xl": "28px"
    },
    "shadows": {
      "surface": "0 20px 60px rgba(27,77,72,0.07), 0 2px 8px rgba(27,77,72,0.03)",
      "glow": "0 0 64px rgba(196,168,130,0.18)",
      "card": "0 0 0 1px rgba(27,77,72,0.05), 0 8px 32px rgba(27,77,72,0.06)"
    },
    "borders": {
      "default": "rgba(27,77,72,0.09)",
      "accent": "rgba(196,168,130,0.32)",
      "subtle": "rgba(27,77,72,0.05)"
    },
    "animation": "serenity-fade"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "professional",
    "layoutKind": "single-column",
    "templateIntelligenceId": "ti-samp-growth"
  }
}
