      "surface": "#D8CFE8",
      "surface-elevated": "#F9F7FD",
      "signal": "#FF5C8A",
      "grid": "rgba(78,61,107,0.07)",
      "ink": "#1A1228",
      "sand": "#D8CFE8",
      "azure": "#FF5C8A",
      "azure-light": "#FF8FB0",
      "azure-deep": "#E03D72",
      "pearl": "#F9F7FD"
    },
    "typography": {
      "display": "Playfair Display, ui-serif, Georgia, serif",
      "body": "Outfit, ui-sans-serif, system-ui, sans-serif",
      "mono": "ui-monospace, monospace",
