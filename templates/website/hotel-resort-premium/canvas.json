      "card": "0 22px 52px rgba(42,35,64,0.1), 0 10px 24px rgba(255,92,138,0.08), 0 0 0 1px rgba(78,61,107,0.08)"
    },
    "borders": {
      "default": "rgba(26,18,40,0.11)",
      "accent": "rgba(255,92,138,0.32)",
      "subtle": "rgba(78,61,107,0.1)"
