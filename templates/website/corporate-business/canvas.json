{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "2rem",
    "margin": "1.5rem",
    "maxWidth": "88rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": ["0.5", "1", "1.5", "2", "3", "4", "5", "6", "8", "10", "12", "16"]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#080E18",
      "secondary": "#152238",
      "accent": "#C4A574",
      "background": "#F7F6F3",
      "foreground": "#080E18",
      "muted": "rgba(8,14,24,0.58)",
      "surface": "#FFFFFF",
      "surfaceElevated": "#FDFCF9",
      "signal": "#C4A574",
      "grid": "rgba(8,14,24,0.04)",
      "ink": "#080E18"
    },
    "typography": {
      "display": "Cormorant Garamond, ui-serif, Georgia, serif",
      "body": "Inter, ui-sans-serif, system-ui, sans-serif",
      "mono": "DM Mono, ui-monospace, monospace",
      "scale": {
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.375rem",
        "xl": "3.25rem",
        "display": "clamp(3.25rem, 7.5vw, 5.75rem)"
      }
    },
    "radius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "xl": "20px"
    },
    "shadows": {
      "surface": "0 20px 60px rgba(8,14,24,0.07), 0 2px 8px rgba(8,14,24,0.03)",
      "glow": "0 0 64px rgba(196,165,116,0.18)",
      "card": "0 0 0 1px rgba(8,14,24,0.04), 0 4px 24px rgba(8,14,24,0.04)"
    },
    "borders": {
      "default": "rgba(8,14,24,0.08)",
      "accent": "rgba(196,165,116,0.32)",
      "subtle": "rgba(8,14,24,0.05)"
    },
    "animation": "atlas-reveal"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "Corporate",
    "layoutKind": "single-column",
    "templateIntelligenceId": "ti-corporate-trust"
  }
}
