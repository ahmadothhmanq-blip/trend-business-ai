{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "2rem",
    "margin": "0",
    "maxWidth": "100%"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.5",
      "1",
      "2",
      "3",
      "4",
      "6",
      "8",
      "12"
    ]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#0F172A",
      "secondary": "#334155",
      "accent": "#C9A962",
