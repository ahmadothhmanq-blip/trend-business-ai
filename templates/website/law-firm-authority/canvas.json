      "muted": "rgba(248,250,252,0.62)",
      "surface": "#0F172A"
    },
    "typography": {
      "display": "Cormorant Garamond, ui-serif, Georgia, serif",
      "body": "Source Sans 3, ui-sans-serif, system-ui, sans-serif",
