{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "2rem",
    "margin": "0",
    "maxWidth": "100%"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.5",
      "1",
      "2",
      "3",
      "4",
      "6",
      "10",
      "16"
    ]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#1A1A1A",
      "secondary": "#8C7B6B",
      "accent": "#C9A962",
      "background": "#0F0E0D",
      "foreground": "#F5F0E8",
      "muted": "rgba(245,240,232,0.6)",
      "surface": "#1F1D1B"
    },
    "typography": {
      "display": "Playfair Display, ui-serif, Georgia, serif",
      "body": "Lato, ui-sans-serif, system-ui, sans-serif",
