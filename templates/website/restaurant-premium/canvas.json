{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "1.25rem",
    "maxWidth": "90rem"
  },
  "spacing": {
    "unit": "rem",
    "scale": ["0.5", "1", "1.5", "2", "3", "4", "5", "6", "8", "10", "12"]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#1A1410",
      "secondary": "#2A2118",
      "accent": "#C87840",
      "background": "#110D0A",
      "foreground": "#F5EDE4",
      "muted": "rgba(245,237,228,0.62)",
      "surface": "#1f1812",
      "signal": "#C87840",
      "grid": "rgba(200,120,64,0.08)",
      "ink": "#110D0A",
      "copper": "#cf8857",
      "ember": "#a46234",
      "linen": "#f5ede5"
    },
    "typography": {
      "display": "Fraunces, ui-serif, Georgia, serif",
      "body": "Literata, ui-serif, Georgia, serif",
      "mono": "ui-monospace, monospace",
      "scale": {
        "sm": "0.8125rem",
        "base": "1.0625rem",
        "lg": "1.375rem",
        "xl": "3.5rem",
        "display": "clamp(2.875rem, 6.5vw, 5rem)"
      }
    },
    "radius": {
      "sm": "2px",
      "md": "4px",
      "lg": "8px",
      "xl": "12px"
    },
    "shadows": {
      "surface": "0 12px 40px rgba(0,0,0,0.28)",
      "glow": "0 0 96px rgba(200,120,64,0.22)",
      "card": "0 0 0 1px rgba(245,237,228,0.08), 0 16px 48px rgba(0,0,0,0.32)"
    },
    "borders": {
      "default": "rgba(245,237,228,0.12)",
      "accent": "rgba(200,120,64,0.38)",
      "subtle": "rgba(245,237,228,0.06)"
    },
    "animation": "ember-table-reveal"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "luxury",
    "layoutKind": "cinematic-fullbleed",
    "templateIntelligenceId": "ti-restaurant-dining"
  }
}
