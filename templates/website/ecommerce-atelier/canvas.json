{
  "id": "canvas",
  "grid": {
    "columns": 12,
    "gutter": "1.5rem",
    "margin": "0",
    "maxWidth": "100%"
  },
  "spacing": {
    "unit": "rem",
    "scale": [
      "0.5",
      "1",
      "1.5",
      "2",
      "3",
      "4",
      "6",
      "10"
    ]
  },
  "visualIdentity": {
    "colors": {
      "primary": "#141414",
      "secondary": "#737373",
      "accent": "#A3A3A3",
      "background": "#FAFAFA",
      "foreground": "#0A0A0A",
      "muted": "rgba(10,10,10,0.55)",
      "surface": "#FFFFFF"
    },
    "typography": {
      "display": "Didot, ui-serif, Georgia, serif",
      "body": "Helvetica Neue, ui-sans-serif, system-ui, sans-serif",
      "scale": {
        "sm": "0.875rem",
        "base": "1rem",
        "lg": "1.5rem",
        "xl": "3rem"
      }
    },
    "radius": {
      "sm": "0",
      "md": "0",
      "lg": "0"
    },
    "shadows": {
      "surface": "none"
    },
    "borders": {
      "default": "rgba(0,0,0,0.08)"
    },
    "animation": "atelier-scroll"
  },
  "designSystem": {
    "tier": "premium",
    "industry": "E-commerce",
    "layoutKind": "full-bleed",
    "templateIntelligenceId": "ti-ecommerce-atelier"
  }
}
